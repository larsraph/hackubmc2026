[sub_resource type="GDScript" id="GDScript_e4ynd"]
script/source = "extends Node2D

@export var a: RigidBody2D
@export var b: RigidBody2D
@export var sprite: Sprite2D

@export var max_rotation_speed: float = 400 * PI

var last = Vector2(0, 0)

func _physics_process(delta: float) -> void:
	var avg = (a.global_position + b.global_position) / 2.0

	sprite.global_position = avg

	var line = (b.global_position - a.global_position) / 2.0

	sprite.global_rotation = line.angle()

	var mouse_position = get_global_mouse_position()
	var target_angle = avg.direction_to(mouse_position).angle()

	var delta_angle = wrapf(
		target_angle - line.angle(),
		-PI,
		PI
	)

	# Limit how much the body pair can rotate in one physics frame.
	var max_angle_change = max_rotation_speed * delta
	delta_angle = clamp(
		delta_angle,
		-max_angle_change,
		max_angle_change
	)

	# Calculate where B would be after rotating around the midpoint.
	var rotated_line = line.rotated(delta_angle)

	# This is B's desired displacement.
	var displacement = rotated_line - line

	# Convert displacement into velocity.
	var velocity = displacement / delta

	# Same logic as before:
	# remove last frame's rotational velocity,
	# then add this frame's desired rotational velocity.
	var velocity_change_b = velocity - last
	var velocity_change_a = -velocity_change_b

	# F = m * Δv / Δt
	var force_b = velocity_change_b * b.mass / delta
	var force_a = velocity_change_a * a.mass / delta

	b.apply_central_force(force_b)
	a.apply_central_force(force_a)

	last = velocity
"

